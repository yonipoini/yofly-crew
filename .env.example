# YoFly Crew workspace Supabase configuration
# Create a NEW Supabase project for this workspace.
# Do not reuse the Antigravity project's Supabase credentials here.
EXPO_PUBLIC_SUPABASE_URL=https://your-new-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-new-anon-key

# Default hub
EXPO_PUBLIC_DEFAULT_AIRPORT_CODE=JFK
EXPO_PUBLIC_DEFAULT_AIRPORT_ICAO=KJFK

# Optional external APIs
# Expo Go can use Google Places web-service calls, but keep the key restricted.
# Disabled by default so development/testing cannot accidentally generate billable Places usage.
EXPO_PUBLIC_GOOGLE_PLACES_ENABLED=false
EXPO_PUBLIC_GOOGLE_PLACES_RICH_DETAILS_ENABLED=false
EXPO_PUBLIC_GOOGLE_PLACES_MAX_SESSION_REQUESTS=20
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_NATIVE_ENABLED=false
EXPO_PUBLIC_GOOGLE_PLACES_RADIUS_METERS=4000
# Marketplace listing address geocoding is a separate user-action-only opt-in.
EXPO_PUBLIC_GOOGLE_GEOCODING_ENABLED=false
EXPO_PUBLIC_GOOGLE_GEOCODING_MAX_SESSION_REQUESTS=3
EXPO_PUBLIC_PLACES_ENDPOINT=

# Optional backend proxy for airport delay/status data.
# Leave blank until you have a server or Supabase Edge Function for FAA/flight status data.
EXPO_PUBLIC_AIRPORT_STATUS_ENDPOINT=
EXPO_PUBLIC_FLIGHT_STATUS_ENDPOINT=
EXPO_PUBLIC_TSA_ESTIMATE_ENDPOINT=

# Repo helper:
# npm run backend:verify
# checks whether the live Supabase Edge Functions are reachable for JFK.

# Server-side only:
# Store FlightAware in a backend or Supabase Edge Function secret.
# Do not expose it as an EXPO_PUBLIC_* variable.
# Example:
# supabase secrets set FLIGHTAWARE_API_KEY=your_key_here
#
# Optional TSA fallback provider:
# keep partner keys server-side and proxy them through a backend or Supabase Edge Function.
# Example secrets:
# supabase secrets set TSA_ESTIMATE_ENDPOINT=https://your-provider.example.com/wait-times
# supabase secrets set TSA_ESTIMATE_API_KEY=your_partner_key
# Or use TSAWaitTimes.com as the default provider for the `tsa-estimates` function:
# supabase secrets set TSA_WAIT_TIMES_API_KEY=your_tsawaittimes_key

# Mapbox Settings
# Set EXPO_PUBLIC_USE_MAPBOX to true to swap standard maps with Mapbox (requires custom dev client/EAS build).
EXPO_PUBLIC_USE_MAPBOX=false
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-public-token-here
